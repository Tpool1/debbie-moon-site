         <pdfx:ecv-data>{"_id":"6a70af91de4f16c30aa45b3b","style":{"background":null,"colors":["#19273C","#3C6DF0"],"columnLayoutOption":1,"fontBody":"opensans","fontHeading":"montserratlocked","fontSize":1,"headerExtraSpacing":0,"isMetaDataDisabled":true,"isSectionNameUppercase":null,"layout":"timeline","layoutSize":"medium","lineHeightOption":0,"marginOption":1,"pageMarginOption":2,"record":"ResumeStyle","signaturePage":null},"header":{"contacts":"","customHeight":188,"dateOfBirth":"","email":"debbie.ibarra@gmail.com","extraField":"","extraLink":"www.dmoonmarketing.com","height":99,"link":"www.linkedin.com/in/debbiehmoon","location":"Round Rock (Austin), TX","name":"DEBBIE MOON","nationality":"","phone":"+17143484214","photo":"","photoStyle":"round","record":"Header","showDateOfBirth":false,"showEmail":true,"showExtraField":false,"showExtraLink":true,"showLink":true,"showLocation":false,"showNationality":false,"showPhone":true,"showPhoto":false,"showTitle":true,"title":"Marketing Executive | B2B SaaS &amp;amp; AI Platforms | Pipeline, Brand &amp;amp; GTM","uppercaseName":true},"sections":[{"__t":"SummarySection","column":1,"enabled":true,"height":30,"items":[{"height":110,"id":"zbeuobtymb","record":"SummaryItem","alignment":"left","text":"Marketing executive with 20+ years building brand, corporate communications, and product marketing, with demand generation and go-to-market strategy as the core focus. Brought in repeatedly to build and scale marketing functions from zero, most recently at AI and technical platform companies selling into regulated markets. Operates as a hands-on leader, setting strategy while staying close enough to the work to deliver measurable revenue results, and partners at the CxO level (CEO, CRO, CPO) on budget, board reporting, and growth targets. Core toolkit: GTM strategy, ABM and demand generation, brand and positioning, board and investor reporting, budget and P&amp;amp;L management, pipeline attribution, PR and analyst relations, Salesforce and HubSpot, AI-native workflows."}],"name":"","record":"SummarySection","showTitle":true},{"__t":"AchievementSection","column":1,"enabled":true,"height":30,"items":[{"height":118,"id":"1ybhhajyvb","record":"AchievementItem","alignment":"left","description":"Repeatedly recruited to build and scale marketing functions from zero at high-growth startups, including three AI platform companies, standing up positioning, pipeline infrastructure, demand generation, and full corporate websites, averaging 45 days from blank page to live.","icon":"06-free-cog-gear","showDescription":true,"showTitle":true,"title":"Built &amp;amp; Scaled Marketing Functions"},{"height":118,"id":"qib168ir9e","record":"AchievementItem","alignment":"left","description":"Generated 10,000 leads, 300 MQLs, and 60 SQLs in six months at Behavox, exceeding pipeline targets by 3x. Grew NobleAI's marketing-sourced pipeline from $3.9M to $26.8M over three years, tying spend directly to revenue outcomes.","icon":"101-target-01","showDescription":true,"showTitle":true,"title":"Drove Pipeline Growth &amp;amp; Revenue Attribution"}],"name":"","record":"AchievementSection","showIcons":true},{"__t":"ExperienceSection","column":0,"enabled":true,"height":30,"items":[{"dateRange":{"fromMonth":3,"fromYear":2026,"isOngoing":false,"ongoingText":"","record":"DateRange","toMonth":6,"toYear":2026},"table":{"cols":2,"record":"TableItem","rows":[["&lt;b&gt;Project name&lt;/b&gt;","&lt;b&gt;Description&lt;/b&gt;"],["",""]]},"height":188,"id":"svgr9cks8n","record":"ExperienceItem","alignment":"left","bullets":["Recruited as the first marketing hire; wrote the company's corporate messaging and positioning and led the brand identity redesign in three weeks.","Delivered the full website redesign in 30 days, partnering with an external development agency and personally writing all site copy. Replaced original site's single contact form with five-plus conversion paths for inbound leads.","Created the company's content strategy, using AI tools like Claude and Perplexity to speed up keyword research and first drafts.","Laid the groundwork for demand generation infrastructure, including pipeline forecasting and budget planning."],"companyLogo":"https://enhancv.s3.amazonaws.com/company-logos-cache/simplifyx.com.png","description":"Enterprise agentic AI platform delivering vertical intelligence for finance services and operations-intensive industries.","link":"","location":"Remote","position":"Senior Vice President, Marketing","showBullets":true,"showCompany":true,"showDateRange":true,"showDescription":true,"showLink":false,"showLocation":true,"showTable":true,"showTitle":true,"workplace":"SimplifyX (position eliminated due to a company-wide reduction-in-force)"},{"dateRange":{"fromMonth":10,"fromYear":2025,"isOngoing":false,"ongoingText":"","record":"DateRange","toMonth":3,"toYear":2026},"table":{"cols":2,"record":"TableItem","rows":[["&lt;b&gt;Project name&lt;/b&gt;","&lt;b&gt;Description&lt;/b&gt;"],["",""]]},"height":204,"id":"aljuplla1j","record":"ExperienceItem","alignment":"left","bullets":["Launched the Enterprise team's first demand generation engine, with pipeline forecasting toward a $10M target.","Overhauled the content repository, replacing one-off production with a strategy built around the customer journey. Equipped Sales with new assets and competitive intel.","Established the company's press and analyst relations program and an event strategy centered on industry speaking opportunities.","Developed a marketing framework adopted by both the Enterprise and Government business units, each adapting it to their own ICP and pipeline goals."],"companyLogo":"https://enhancv.s3.amazonaws.com/company-logos-cache/seekr.com.png","description":"GenAI software company delivering explainable AI models and a secure platform for highâ€‘value enterprises in regulated industries such as financial services, telecom, manufacturing.","link":"","location":"Remote","position":"Vice President Of Marketing","showBullets":true,"showCompany":true,"showDateRange":true,"showDescription":true,"showLink":false,"showLocation":true,"showTable":true,"showTitle":true,"workplace":"Seekr Technologies"},{"dateRange":{"fromMonth":11,"fromYear":2022,"isOngoing":false,"ongoingText":"","record":"DateRange","toMonth":11,"toYear":2025},"table":{"cols":2,"record":"TableItem","rows":[]},"height":236,"id":"mjddt4xfkl","record":"ExperienceItem","alignment":"left","bullets":["Grew marketing-sourced and attributed pipeline from $3.9M to $26.8M over three years, increasing marketing's share from 15% to 43% of total new pipeline.","Grew marketing-sourced new bookings to 87% of marketing-attributed new revenue by year three, up from 13% in year one.","First marketing hire: built category positioning, corporate messaging, and product marketing from scratch, including press and analyst relations strategy and the company's first website within 45 days.","Led integrated demand generation programs across digital, paid media, and events, managing a team of three plus contractors and agency partners, and owned the marketing budget with quarterly performance reporting to the board and executive leadership."],"companyLogo":"","description":"Specialized AI software company delivering science-based AI models for product innovation in chemicals, energy, and manufacturing companies.","link":"","location":"Remote","position":"Vice President of Marketing","showBullets":true,"showCompany":true,"showDateRange":true,"showDescription":true,"showLink":false,"showLocation":true,"showTable":true,"showTitle":true,"workplace":"NobleAl"},{"dateRange":{"fromMonth":6,"fromYear":2021,"isOngoing":false,"ongoingText":"","record":"DateRange","toMonth":10,"toYear":2022},"table":{"cols":2,"record":"TableItem","rows":[]},"height":204,"id":"olugcyr8al","record":"ExperienceItem","alignment":"left","bullets":["First marketing leadership hire: shaped messaging, brand identity, and demand generation infrastructure.","Launched an ABM strategy targeting the top 50 to 100 mining operators in the US, backed by integrated event, digital, and social efforts that grew brand visibility with enterprise and technical buyers.","Created a formal content and centralized slide library to support sales enablement across two distinct ICPs, managing a team of two marketers, two BDRs, and agency partners.","Designed and ran an outreach program with leading mining schools, generating early brand awareness with the next generation of industry engineers and decision makers."],"companyLogo":"","description":"An industrial technology company providing drone hardware and data analytics software for construction, mining, and related enterprises.","link":"","location":"Remote","position":"Vice President of Marketing","showBullets":true,"showCompany":true,"showDateRange":true,"showDescription":true,"showLink":false,"showLocation":true,"showTable":true,"showTitle":true,"workplace":"Skycatch"},{"dateRange":{"fromMonth":6,"fromYear":2020,"isOngoing":false,"ongoingText":"","record":"DateRange","toMonth":5,"toYear":2021},"table":{"cols":2,"record":"TableItem","rows":[]},"height":188,"id":"zex3nrv488","record":"ExperienceItem","alignment":"left","bullets":["Stood up the demand generation function, including lead management, pipeline forecasting, and global campaign strategy, to support a $20M ARR goal.","Generated 10,000 leads, 300 MQLs, and 60 SQLs in six months, exceeding pipeline targets by 3x, all executed virtually during COVID across a global customer base.","Produced global virtual events, executive panels, and closed-door customer sessions to drive thought leadership and net new pipeline; managed a team of four plus agency partners."],"companyLogo":"","description":"A security and compliance&amp;nbsp;software platform&amp;nbsp;used by global banks and financial institutions to manage risk and employee conduct.","link":"","location":"Remote","position":"Vice President, Demand Generation","showBullets":true,"showCompany":true,"showDateRange":true,"showDescription":true,"showLink":false,"showLocation":true,"showTable":true,"showTitle":true,"workplace":"Behavox"},{"dateRange":{"fromMonth":0,"fromYear":2020,"isOngoing":false,"ongoingText":"","record":"DateRange","toMonth":3,"toYear":2020},"table":{"cols":2,"record":"TableItem","rows":[]},"height":108,"id":"96e55bbru4","record":"ExperienceItem","alignment":"left","bullets":["Increased pipeline growth by 300% through integrated digital marketing and improved lead conversion by 20% through persona-driven content development."],"companyLogo":"","description":"Financial planning and analysis software helping businesses streamline budgeting, forecasting, and reporting.","link":"","location":"San Francisco, CA","position":"Director, Demand Generation","showBullets":true,"showCompany":true,"showDateRange":true,"showDescription":true,"showLink":false,"showLocation":true,"showTable":true,"showTitle":true,"workplace":"Planful (position eliminated due to COVID-19 impact)"},{"dateRange":{"fromMonth":7,"fromYear":2018,"isOngoing":false,"ongoingText":"","record":"DateRange","toMonth":1,"toYear":2020},"table":{"cols":2,"record":"TableItem","rows":[]},"height":188,"id":"xge8sf8lor","record":"ExperienceItem","alignment":"left","bullets":["Rejoined and was promoted to Sr. Director, expanding scope to include partner and channel marketing across regions.","Ran demand generation across digital, ABM, and global field marketing, and supported a full company rebrand and website redesign.","Directed high-impact events including annual Sales Kickoffs and quarterly Customer Advisory Boards, and mentored a team of two plus agency partners."],"companyLogo":"","description":"Enterprise IT infrastructure company offering performance monitoring and AIOps solutions for hybrid cloud environments.","link":"","location":"San Jose, CA","position":"Sr. Director, Demand Generation Marketing &amp;amp; Events","showBullets":true,"showCompany":true,"showDateRange":true,"showDescription":true,"showLink":false,"showLocation":true,"showTable":true,"showTitle":true,"workplace":"Virtana (formerly Virtual Instruments)"},{"dateRange":{"fromMonth":7,"fromYear":2016,"isOngoing":false,"ongoingText":"","record":"DateRange","toMonth":7,"toYear":2018},"table":{"cols":2,"record":"TableItem","rows":[["&lt;b&gt;Project name&lt;/b&gt;","&lt;b&gt;Description&lt;/b&gt;"],["",""]]},"height":108,"id":"1qowxt1xjo","record":"ExperienceItem","alignment":"left","bullets":["Managed global marketing programs across digital, demand generation, and events, supporting B2B IoT and Smart Cities initiatives across global field teams and agencies.."],"companyLogo":"https://enhancv.s3.amazonaws.com/company-logos-cache/hitachivantara.com.png","description":"Global technology company focused on data infrastructure, analytics, and IoT.","link":"","location":"San Jose, CA","position":"Sr. Marketing Manager, Demand Generation","showBullets":true,"showCompany":true,"showDateRange":true,"showDescription":true,"showLink":false,"showLocation":true,"showTable":true,"showTitle":true,"workplace":"Hitachi Vantara"},{"dateRange":{"fromMonth":0,"fromYear":2007,"isOngoing":false,"ongoingText":"","record":"DateRange","toMonth":7,"toYear":2016},"table":{"cols":2,"record":"TableItem","rows":[]},"height":89,"id":"8g3yd2b5na","record":"ExperienceItem","alignment":"left","bullets":[""],"companyLogo":"","description":"Independent consultancy specializing in brand strategy, demand generation, and digital marketing. Clients included Cisco Systems, Brocade, Nike special projects via Razorfish, and the NBA Portland Trail Blazers.","link":"","location":"NY | OR | CA","position":"Sr. Marketing and Advertising Consultant","showBullets":false,"showCompany":true,"showDateRange":true,"showDescription":true,"showLink":false,"showLocation":true,"showTable":true,"showTitle":true,"workplace":"D. Moon Consulting | Various Locations"}],"name":"","record":"ExperienceSection","showCompanyLogos":false,